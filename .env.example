# ---- Revolut X ----
# 64-character API key from the Revolut X web app (Profile -> API keys).
REVOLUT_X_API_KEY=
# Absolute path to your Ed25519 PKCS#8 PEM private key. Keep it OUTSIDE this repository, chmod 600.
REVOLUT_X_PRIVATE_KEY_PATH=
REVOLUT_X_BASE_URL=https://revx.revolut.com
# Region passed to public market-data endpoints (UK or EEA).
REVOLUT_X_REGION=UK

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://crypto:crypto@localhost:5433/crypto_terminal

# ---- Market data polling (seconds). Public endpoints allow ~1 request/second each. ----
MARKET_POLL_INTERVAL=3
TICKER_POLL_INTERVAL=3
# Market data older than this is considered stale and blocks new orders.
STALE_DATA_SECONDS=30

# ---- Paper trading ----
PAPER_STARTING_BALANCE=10000
# Taker fee used for paper fills (Revolut X spot tier-0 taker fee is 0.09%).
PAPER_FEE_RATE=0.0009

# ---- Server ----
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
LOG_LEVEL=INFO
